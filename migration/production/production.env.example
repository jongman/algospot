# Keep the real file outside Git with mode 0600.
POSTGRES_USER=algospot
POSTGRES_PASSWORD=replace-with-a-random-password
ALGOSPOT_SECRET_KEY=replace-with-a-distinct-random-secret
ALGOSPOT_APP_DIR=/srv/algospot/app
ALGOSPOT_POSTGRES_DIR=/var/lib/algospot/postgres
ALGOSPOT_MEDIA_DIR=/var/lib/algospot/media
ALGOSPOT_JUDGE_WORK_DIR=/var/lib/algospot/judge-work
ALGOSPOT_DATABASE_DUMP=/var/lib/algospot/backups/algospot.pgdump
ALGOSPOT_ALLOWED_HOSTS=algospot.com,www.algospot.com,localhost,127.0.0.1
ALGOSPOT_CSRF_TRUSTED_ORIGINS=https://algospot.com,https://www.algospot.com
ALGOSPOT_REJUDGE_ENABLED=0
PUID=1000
PGID=1000
DOCKER_GID=988

# Safe staging defaults: reachable only through an SSH tunnel.
ALGOSPOT_BIND_ADDRESS=127.0.0.1
ALGOSPOT_HTTP_PORT=18090
ALGOSPOT_HTTPS_PORT=18443
ALGOSPOT_SITE_ADDRESS=http://:80
ALGOSPOT_SECURE_SSL_REDIRECT=0
ALGOSPOT_SESSION_COOKIE_SECURE=0
ALGOSPOT_CSRF_COOKIE_SECURE=0
ALGOSPOT_SECURE_HSTS_SECONDS=0
JUDGE_REQUIRE_IMAGE_DIGESTS=0

# Keep the dummy backend until configure-resend.sh installs the production key.
ALGOSPOT_EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
ALGOSPOT_EMAIL_HOST=smtp.resend.com
ALGOSPOT_EMAIL_PORT=587
ALGOSPOT_EMAIL_HOST_USER=resend
ALGOSPOT_EMAIL_HOST_PASSWORD=
ALGOSPOT_EMAIL_USE_TLS=1
ALGOSPOT_EMAIL_USE_SSL=0
ALGOSPOT_EMAIL_TIMEOUT=10
ALGOSPOT_DEFAULT_FROM_EMAIL=noreply@notify.algospot.com
ALGOSPOT_SERVER_EMAIL=noreply@notify.algospot.com
